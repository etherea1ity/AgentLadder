# AgentLadder v0.1 Minimal Agent
# Copy this file to .env and fill in your real API key locally.
# Never commit your real .env file.

# DashScope / Alibaba Cloud Bailian API key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional fast/quality model switch. Default in configs/default.yaml is qwen3.6-flash.
# Examples: qwen3.6-flash, qwen3.6-plus, qwen-flash, qwen-turbo
AGENT_LADDER_MODEL=qwen3.6-flash
AGENT_LADDER_ENABLE_THINKING=false
