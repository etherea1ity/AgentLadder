# Required for chat model providers.
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# Optional web search providers. DuckDuckGo Lite runs without a key but may be
# blocked by anti-bot challenge pages, so keyed providers are recommended.
TAVILY_API_KEY=
SERPAPI_API_KEY=
WEB_SEARCH_PROVIDER_ORDER=duckduckgo_lite,tavily,serpapi

# Optional local runtime paths. Defaults are used when omitted.
# KLARA_APP_DATA=data/app
# KLARA_TRACE_PATH=data/traces/runs.jsonl
