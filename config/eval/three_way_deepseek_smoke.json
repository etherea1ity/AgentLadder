        "type": "object",
        "properties": {
          "skill_name": {
            "type": "string"
          }
        },
        "required": ["skill_name"],
        "additionalProperties": false
      }
    },
    {
      "name": "web_search",
      "description": "Search the public web and return a small result list.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "name": "memory_search",
      "description": "Search the user's local memory for a fact.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": ["query"],
        "additionalProperties": false
      }
    }
  ],
  "tasks": [
    {
