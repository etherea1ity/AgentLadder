{
  "schema_version": "klara.frozen-tool-fixture.v1",
  "name": "deepseek_frozen_tool_smoke",
  "task_set": "deepseek_frozen_tool_smoke",
  "system_prompt": "You are Klara under a frozen-tool evaluation. For each user task, call exactly the requested tool with the exact required arguments, then answer the user question using only the returned observation. Do not invent results and do not call extra tools.",
  "tools": [
    {
      "name": "current_time",
      "description": "Return the current local time as an ISO-8601 timestamp.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "skills_list",
      "description": "List the names of all available Klara skills.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "skill_view",
      "description": "Return the public detail of one skill.",
