      "arguments": {"query": "Klara frozen tool backend"},
      "result": {
        "content": "{\"results\": [{\"title\": \"Frozen Tool Backend\", \"url\": \"https://example.com/frozen-tool-backend\", \"snippet\": \"A deterministic eval-time tool backend for Klara.\"}]}",
