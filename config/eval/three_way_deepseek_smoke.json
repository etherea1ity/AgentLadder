      "expected_tool_calls": [
        {"name": "skills_list", "arguments": {}}
      ],
      "must_call_tools": ["skills_list"],
      "may_call_tools": ["skills_list"]
    },
    {
      "id": "skill_view_status",
      "user_turn": "Call the skill_view tool for skill_name 'web-research', then tell me its status value.",
      "reference_answer": "active",
      "acceptable_answers": [],
      "expected_tool_calls": [
        {"name": "skill_view", "arguments": {"skill_name": "web-research"}}
      ],
      "must_call_tools": ["skill_view"],
      "may_call_tools": ["skill_view"]
    },
    {
      "id": "web_search_title",
      "user_turn": "Call the web_search tool with query 'Klara frozen tool backend', then tell me the title of the first result.",
      "reference_answer": "Frozen Tool Backend",
      "acceptable_answers": [],
      "expected_tool_calls": [
        {"name": "web_search", "arguments": {"query": "Klara frozen tool backend"}}
      ],
      "must_call_tools": ["web_search"],
      "may_call_tools": ["web_search"]
    },
    {
      "id": "memory_search_deadline",
      "user_turn": "Call the memory_search tool with query 'project deadline', then tell me the deadline it returned.",
      "reference_answer": "2026-08-20",
      "acceptable_answers": [],
      "expected_tool_calls": [
        {"name": "memory_search", "arguments": {"query": "project deadline"}}
      ],
      "must_call_tools": ["memory_search"],
      "may_call_tools": ["memory_search"]
    }
  ],
  "entries": [
    {
      "tool_name": "current_time",
      "arguments": {},
      "result": {
        "content": "2026-08-16T12:00:00+08:00",
        "ok": true
      }
    },
    {
      "tool_name": "skills_list",
      "arguments": {},
