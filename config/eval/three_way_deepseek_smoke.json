      "user_turn": "Call the current_time tool, then tell me exactly the ISO-8601 timestamp it returned.",
      "reference_answer": "2026-08-16T12:00:00+08:00",
      "acceptable_answers": [],
      "expected_tool_calls": [
        {"name": "current_time", "arguments": {}}
      ],
      "must_call_tools": ["current_time"],
      "may_call_tools": ["current_time"]
    },
    {
      "id": "skills_list_count",
      "user_turn": "Call the skills_list tool, then tell me how many skills are listed.",
      "reference_answer": "3",
